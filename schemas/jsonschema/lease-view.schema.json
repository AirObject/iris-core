{
  "$id": "https://schemas.iris-memory-core.local/v1/lease-view.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acquired_us": {
      "minimum": 0,
      "type": "integer"
    },
    "agent_id": {
      "minLength": 1,
      "type": "string"
    },
    "expires_us": {
      "minimum": 0,
      "type": "integer"
    },
    "holder_app_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "holder_space_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_heartbeat_us": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "priority": {
      "minimum": 0,
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "active",
        "draining",
        "released",
        "expired"
      ]
    },
    "tenant_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "tenant_id",
    "agent_id",
    "holder_app_instance_id",
    "lease_epoch",
    "status",
    "expires_us"
  ],
  "title": "LeaseView",
  "type": "object"
}
