{
  "$id": "https://schemas.iris-memory-core.local/v1/observation-context-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "end_us": {
      "minimum": 1,
      "type": "integer"
    },
    "include_summaries": {
      "default": true,
      "type": "boolean"
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "limit": {
      "default": 100,
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
    },
    "purpose": {
      "default": "reply",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "session_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "space_group_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "space_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "space_id"
      ],
      "type": "object"
    },
    "start_us": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "scope"
  ],
  "title": "ObservationContextRequest",
  "type": "object"
}
