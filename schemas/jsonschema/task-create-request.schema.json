{
  "$id": "https://schemas.iris-memory-core.local/v1/task-create-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "dependentRequired": {
    "session_id": [
      "space_id"
    ]
  },
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": "string"
    },
    "due_at_us": {
      "minimum": 0,
      "type": "integer"
    },
    "goal": {
      "maxLength": 8000,
      "type": "string"
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "next_action": {
      "maxLength": 2000,
      "type": "string"
    },
    "origin": {
      "enum": [
        "explicit_tool",
        "admin",
        "policy",
        "conversation",
        "background"
      ]
    },
    "owner_entity_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_kind": {
      "enum": [
        "agent",
        "joint",
        "entity",
        "space_group"
      ]
    },
    "priority": {
      "maximum": 9,
      "minimum": 0,
      "type": "integer"
    },
    "privacy_labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "session_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "resource_type": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "space_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "title"
  ],
  "title": "TaskCreateRequest",
  "type": "object"
}
