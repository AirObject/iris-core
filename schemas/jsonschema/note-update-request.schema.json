{
  "$id": "https://schemas.iris-memory-core.local/v1/note-update-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "body": {
      "maxLength": 20000,
      "type": "string"
    },
    "due_at_us": {
      "minimum": 0,
      "type": "integer"
    },
    "expected_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "importance": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "review_after_us": {
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "expected_revision"
  ],
  "title": "NoteUpdateRequest",
  "type": "object"
}
