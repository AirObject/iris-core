{
  "$id": "https://schemas.iris-memory-core.local/v1/episode-create-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "dependentRequired": {
    "session_id": [
      "space_id"
    ]
  },
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": "string"
    },
    "arousal": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "ended_at_us": {
      "minimum": 0,
      "type": "integer"
    },
    "extractor_version": {
      "type": "string"
    },
    "importance": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "resource_type": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "participant_entity_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "privacy_labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "session_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "resource_type": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "space_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "started_at_us": {
      "minimum": 0,
      "type": "integer"
    },
    "summary": {
      "maxLength": 8000,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "valence": {
      "maximum": 1,
      "minimum": -1,
      "type": "number"
    }
  },
  "required": [
    "agent_id",
    "summary"
  ],
  "title": "EpisodeCreateRequest",
  "type": "object"
}
