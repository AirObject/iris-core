{
  "$id": "https://schemas.iris-memory-core.local/v1/note-create-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "dependentRequired": {
    "session_id": [
      "space_id"
    ]
  },
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": "string"
    },
    "body": {
      "maxLength": 20000,
      "type": "string"
    },
    "due_at_us": {
      "minimum": 0,
      "type": "integer"
    },
    "importance": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "kind": {
      "enum": [
        "important",
        "idea",
        "follow_up",
        "promise",
        "question",
        "observation"
      ]
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "privacy_labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_after_us": {
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "resource_id": {
            "minLength": 1,
            "type": "string"
          },
          "resource_type": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "space_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "kind",
    "title"
  ],
  "title": "NoteCreateRequest",
  "type": "object"
}
