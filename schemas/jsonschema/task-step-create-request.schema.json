{
  "$id": "https://schemas.iris-memory-core.local/v1/task-step-create-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "description": {
      "maxLength": 8000,
      "type": "string"
    },
    "expected_effect": {
      "maxLength": 2000,
      "type": "string"
    },
    "lease_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "ordinal": {
      "minimum": 0,
      "type": "integer"
    },
    "privacy_labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "stable_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "stable_key",
    "title"
  ],
  "title": "TaskStepCreateRequest",
  "type": "object"
}
