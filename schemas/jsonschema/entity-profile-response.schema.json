{
  "$id": "https://iris.memory/schemas/entity-profile-response.schema.json",
  "additionalProperties": false,
  "properties": {
    "builder_version": {
      "minimum": 1,
      "type": "integer"
    },
    "fields": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "minLength": 1,
            "type": "string"
          },
          "conflict_state": {
            "enum": [
              "single",
              "conflict",
              "disputed"
            ],
            "type": "string"
          },
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "freshness_us": {
            "minimum": 0,
            "type": "integer"
          },
          "privacy_labels": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "section": {
            "enum": [
              "identity",
              "preference",
              "relationship",
              "experience",
              "goal",
              "recent_change",
              "interaction",
              "community",
              "fact"
            ],
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "claim_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "claim_id",
                "revision"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "space_group_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "space_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary_text": {
            "type": "string"
          }
        },
        "required": [
          "section",
          "field",
          "summary_text",
          "conflict_state",
          "freshness_us",
          "agent_id",
          "space_group_id",
          "space_id",
          "session_id",
          "privacy_labels",
          "sources"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Serving generation (null on canonical fallback)."
    },
    "source": {
      "description": "Whether the fields came from the trusted projection or the canonical-claim fallback derivation (identical semantics; the fallback never widens results).",
      "enum": [
        "projection",
        "canonical_fallback"
      ],
      "type": "string"
    },
    "source_watermark": {
      "minimum": 0,
      "type": "integer"
    },
    "subject_id": {
      "minLength": 1,
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "entity",
        "relationship",
        "space_group"
      ],
      "type": "string"
    },
    "tombstone_watermark": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "subject_kind",
    "subject_id",
    "source",
    "generation_id",
    "builder_version",
    "source_watermark",
    "tombstone_watermark",
    "fields"
  ],
  "title": "EntityProfileResponse",
  "type": "object"
}
