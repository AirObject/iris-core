      "checkpoints": [{"id":"music-after-restart","entry_id":"music","question":{"sender":"南桥","account_id":"nanqiao","kind":"message","occurred_at":"2026-10-05T09:00:00+08:00","dedupe_key":"q1","content":"你平时喜欢听哪一类音乐？我想给你放点合适的。"},"prepare":{"recent_limit":5},"expected":[{"fact":"Iris 喜欢轻柔的纯音乐，尤其是钢琴独奏。","source_keys":["m2"]}],"forbidden":["南桥喜欢钢琴独奏。"]}]
