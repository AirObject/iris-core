  "script": "import argparse, cProfile, hashlib, json, pstats, sys\nfrom pathlib import Path\np=argparse.ArgumentParser();p.add_argument('--source',type=Path,required=True);p.add_argument('--database',type=Path,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args()\nsys.path.insert(0,str(a.source/'src'));sys.path.insert(0,str(a.source/'evals'))\nfrom benchmark_retrieval import Gateway\nfrom iris.db import Store\nfrom iris.retrieval import Retrieval, DEFAULTS\nstore=Store(a.database)\ntry:\n store.set_setting('retrieval',{**DEFAULTS,'embedding_model':'perf-vector','dtype':'float32','embedding_dimensions':2048})\n r=Retrieval(store,Gateway(2048));query={'text':'参与者1的天文观測记录'}\n for _ in range(5):r.prepare('bench',**query)\n profile=cProfile.Profile();profile.enable()\n for _ in range(5):result=r.prepare('bench',**query)\n profile.disable();stats=pstats.Stats(profile)\n rows=[]\n for (filename,line,name),(cc,nc,tt,ct,callers) in stats.stats.items():\n  if name in ('_rank','lexical_lane','anchored','_hydrate','_select','scores','mentioned','search') or 'sqlite3.Connection' in name:\n   rows.append({'file':Path(filename).name,'function':name,'primitive_calls':cc,'total_calls':nc,'self_ms_per_prepare':tt*200,'cumulative_ms_per_prepare':ct*200})\n data={'settings':DEFAULTS,'samples':5,'note':'cProfile after 5 warmups on existing synthetic 50k database, named prepare. Instrumentation overhead; not an R10 benchmark.',\n       'total_profile_seconds':stats.total_tt,'returned':[{'id':m['id'],'reason':m['reason']} for m in result['memories']],\n       'functions':sorted(rows,key=lambda x:-x['cumulative_ms_per_prepare'])}\n a.out.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n')\n print(a.out)\nfinally:store.close()\n"
